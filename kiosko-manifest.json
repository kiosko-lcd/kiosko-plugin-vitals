{
  "manifest": 1,
  "id": "vitals",
  "package": "kiosko-plugin-vitals",
  "name": {
    "en": "Vitals",
    "es": "Vitales",
    "de": "Vitalwerte",
    "zh-Hant": "機器健康",
    "zh-Hans": "机器健康"
  },
  "version": "0.2.2",
  "description": {
    "en": "The machine at a glance, quiet until something runs hot or fills up. Needs the system vitals source.",
    "es": "La máquina de un vistazo, callada hasta que algo se calienta o se llena. Necesita la fuente de vitales del sistema.",
    "de": "Der Rechner auf einen Blick, unauffällig, bis etwas zu heiß wird oder vollläuft. Braucht die Datenquelle „Vitalwerte des Rechners“.",
    "zh-Hant": "機器狀態一目瞭然，平時保持安靜，直到有東西過熱或滿載。需要系統指標資料來源。",
    "zh-Hans": "机器状态一目了然，平时保持安静，直到有东西过热或占满。需要系统指标数据源。"
  },
  "author": "Kiosko",
  "license": "MIT",
  "homepage": "https://github.com/kiosko-lcd/kiosko-plugin-vitals#readme",
  "repository": "https://github.com/kiosko-lcd/kiosko-plugin-vitals.git",
  "icon": "cpu",
  "sdk": "^0.2.0",
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "languages": [
    "en",
    "es",
    "de",
    "zh-Hant",
    "zh-Hans"
  ],
  "categories": [
    "system"
  ],
  "tags": [
    "cpu",
    "ram",
    "disk",
    "temperature"
  ],
  "permissions": {},
  "riskyOptions": [],
  "requires": [
    {
      "type": "system/vitals",
      "plugin": "system"
    }
  ],
  "optional": [],
  "widgets": [
    {
      "type": "vitals/vitals",
      "name": {
        "en": "System vitals",
        "es": "Vitales del sistema",
        "de": "Vitalwerte des Systems",
        "zh-Hant": "系統指標",
        "zh-Hans": "系统指标"
      },
      "description": {
        "en": "CPU temperature, CPU, RAM and disk in dim ink that only turns amber or red past your thresholds; per-core bars when wide.",
        "es": "Temperatura de CPU, CPU, RAM y disco en tinta apagada que solo se vuelve ámbar o roja al pasar tus umbrales; barras por núcleo si hay ancho.",
        "de": "CPU-Temperatur, CPU, RAM und Laufwerk in gedämpfter Farbe, die erst jenseits deiner Schwellenwerte gelb oder rot wird; Balken pro Kern, wenn genug Breite da ist.",
        "zh-Hant": "CPU 溫度、CPU、RAM 與磁碟以暗色顯示，只有超過你設定的門檻才轉為琥珀色或紅色；寬度足夠時顯示各核心長條。",
        "zh-Hans": "CPU 温度、CPU、RAM 和磁盘以暗色显示，只有超过你设置的阈值才变为琥珀色或红色；宽度足够时显示各核心条形。"
      },
      "icon": "cpu",
      "category": "system",
      "tags": [
        "cpu",
        "ram",
        "disk",
        "temperature"
      ],
      "size": {
        "min": {
          "w": 200,
          "h": 160
        },
        "preferred": {
          "w": 600,
          "h": 390
        }
      },
      "chrome": "card",
      "sources": [
        "system/vitals"
      ],
      "options": {
        "default": {
          "cpuWarn": 85,
          "cpuAlert": 95,
          "ramWarn": 85,
          "ramAlert": 95,
          "diskWarn": 85,
          "diskAlert": 95,
          "tempWarn": 85,
          "tempAlert": 95,
          "showCores": true,
          "perCoreMinWidth": 420,
          "showDisk": true
        },
        "x-ui": {},
        "type": "object",
        "properties": {
          "cpuWarn": {
            "title": "Amber CPU from",
            "description": "Overall and per core.",
            "default": 85,
            "x-ui": {
              "label": {
                "en": "Amber CPU from",
                "es": "CPU ámbar desde",
                "de": "CPU gelb ab",
                "zh-Hant": "CPU 琥珀色門檻",
                "zh-Hans": "CPU 琥珀色阈值"
              },
              "help": {
                "en": "Overall and per core.",
                "es": "Total y por núcleo.",
                "de": "Gesamt und pro Kern.",
                "zh-Hant": "整體與各核心。",
                "zh-Hans": "整体和各核心。"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cpuAlert": {
            "title": "Red CPU from",
            "default": 95,
            "x-ui": {
              "label": {
                "en": "Red CPU from",
                "es": "CPU roja desde",
                "de": "CPU rot ab",
                "zh-Hant": "CPU 紅色門檻",
                "zh-Hans": "CPU 红色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "ramWarn": {
            "title": "Amber RAM from",
            "default": 85,
            "x-ui": {
              "label": {
                "en": "Amber RAM from",
                "es": "RAM ámbar desde",
                "de": "RAM gelb ab",
                "zh-Hant": "RAM 琥珀色門檻",
                "zh-Hans": "RAM 琥珀色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "ramAlert": {
            "title": "Red RAM from",
            "default": 95,
            "x-ui": {
              "label": {
                "en": "Red RAM from",
                "es": "RAM roja desde",
                "de": "RAM rot ab",
                "zh-Hant": "RAM 紅色門檻",
                "zh-Hans": "RAM 红色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "diskWarn": {
            "title": "Amber disk from",
            "default": 85,
            "x-ui": {
              "label": {
                "en": "Amber disk from",
                "es": "Disco ámbar desde",
                "de": "Laufwerk gelb ab",
                "zh-Hant": "磁碟琥珀色門檻",
                "zh-Hans": "磁盘琥珀色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "diskAlert": {
            "title": "Red disk from",
            "default": 95,
            "x-ui": {
              "label": {
                "en": "Red disk from",
                "es": "Disco rojo desde",
                "de": "Laufwerk rot ab",
                "zh-Hant": "磁碟紅色門檻",
                "zh-Hans": "磁盘红色阈值"
              },
              "unit": "%",
              "slider": true
            },
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "tempWarn": {
            "title": "Amber temperature",
            "default": 85,
            "x-ui": {
              "label": {
                "en": "Amber temperature",
                "es": "Temperatura ámbar",
                "de": "Temperatur gelb ab",
                "zh-Hant": "溫度琥珀色門檻",
                "zh-Hans": "温度琥珀色阈值"
              },
              "unit": "°C"
            },
            "type": "integer",
            "minimum": 30,
            "maximum": 120
          },
          "tempAlert": {
            "title": "Red temperature",
            "default": 95,
            "x-ui": {
              "label": {
                "en": "Red temperature",
                "es": "Temperatura roja",
                "de": "Temperatur rot ab",
                "zh-Hant": "溫度紅色門檻",
                "zh-Hans": "温度红色阈值"
              },
              "unit": "°C"
            },
            "type": "integer",
            "minimum": 30,
            "maximum": 120
          },
          "showCores": {
            "title": "Per-core bars",
            "default": true,
            "x-ui": {
              "label": {
                "en": "Per-core bars",
                "es": "Barras por núcleo",
                "de": "Balken pro Kern",
                "zh-Hant": "各核心長條",
                "zh-Hans": "各核心条形"
              }
            },
            "type": "boolean"
          },
          "perCoreMinWidth": {
            "title": "Per-core bars from this width",
            "default": 420,
            "x-ui": {
              "label": {
                "en": "Per-core bars from this width",
                "es": "Barras por núcleo a partir de este ancho",
                "de": "Balken pro Kern ab dieser Breite",
                "zh-Hant": "寬度達此值時顯示各核心長條",
                "zh-Hans": "宽度达到此值时显示各核心条形"
              },
              "advanced": true,
              "unit": "px"
            },
            "type": "integer",
            "minimum": 150,
            "maximum": 2000
          },
          "showDisk": {
            "title": "Disk bar",
            "default": true,
            "x-ui": {
              "label": {
                "en": "Disk bar",
                "es": "Barra del disco",
                "de": "Laufwerksbalken",
                "zh-Hant": "磁碟長條",
                "zh-Hans": "磁盘条形"
              }
            },
            "type": "boolean"
          }
        }
      },
      "screenshot": "docs/vitals.png",
      "animated": false,
      "urgent": false
    }
  ],
  "sources": [],
  "interludes": [],
  "templates": [],
  "support": {
    "issues": "https://github.com/kiosko-lcd/kiosko-plugin-vitals/issues",
    "docs": "https://github.com/kiosko-lcd/kiosko-plugin-vitals#readme"
  }
}
